# .env.coolify.example — Phase 3 secrets template
# Copy to .env on the Coolify server and populate with real values.
# DO NOT commit real values (gitignored via .secrets.local).
#
# Generate secrets:
#   JWT_SECRET:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 32
#   ANON_KEY:          openssl rand -hex 32
#   SERVICE_ROLE_KEY:  openssl rand -hex 32
#   N8N_ENCRYPTION_KEY: openssl rand -hex 32
#   SEARXNG_SECRET:    openssl rand -hex 32

# ============================================================
# Postgres (Supabase + n8n share this)
# ============================================================
POSTGRES_PASSWORD=
POOLER_TENANT_ID=

# ============================================================
# Supabase JWT (used by auth, rest, realtime, storage, functions, studio, kong)
# ============================================================
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=          # openssl rand -hex 32
PG_META_CRYPTO_KEY=       # openssl rand -hex 32

# ============================================================
# n8n (DB = supabase-db, host = n8n.recall-agency.com via Traefik)
# ============================================================
N8N_HOSTNAME=n8n.recall-agency.com
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
SITE_URL=https://n8n.recall-agency.com

# ============================================================
# Neo4j
# ============================================================
NEO4J_AUTH=neo4j/please-change-this-password

# ============================================================
# MinIO
# ============================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=      # openssl rand -hex 32

# ============================================================
# Supabase imgproxy
# ============================================================
IMGPROXY_KEY=             # openssl rand -hex 32
IMGPROXY_SALT=            # openssl rand -hex 32

# ============================================================
# SearXNG
# ============================================================
SEARXNG_SECRET=           # openssl rand -hex 32
SEARXNG_BASE_URL=http://searxng:8080

# ============================================================
# Optional: Google OAuth for Supabase Auth
# ============================================================
ENABLE_GOOGLE_SIGNUP=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
